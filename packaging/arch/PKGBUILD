# Maintainer: WeebLabs <https://github.com/WeebLabs>
# Builds DSPi Console from source against the system Qt 6.
pkgname=dspi-console
pkgver=1.1.6beta4
pkgrel=2
_commit=7b9143787b1f3d60f4a9f757e617e93292c35ea7
pkgdesc="Control application for the DSPi audio processor"
arch=('x86_64')
url="https://github.com/WeebLabs/DSPi-Console-Linux"
license=('unknown')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'hicolor-icon-theme'
         'kwindowsystem' 'libusb' 'systemd-libs' 'libx11' 'gcc-libs' 'glibc')
makedepends=('git' 'cargo' 'cmake')
optdepends=('kwayland-integration: blurred sidebar on KDE Plasma (Wayland)'
            'xdg-desktop-portal: native file dialogs'
            'udisks2: firmware updates')
install=dspi-console.install
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo build --frozen --release
    cmake -S qt -B build -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    cd "$pkgname"
    DESTDIR="$pkgdir" cmake --install build
}
